      "verticalAlign": "top",
      "containerId": null,
      "originalText": "这是 dec_input",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tnRRV4YU1CIAER4GFw69e",
      "type": "text",
      "x": 539.4608138274841,
      "y": 413,
      "width": 511.53997802734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#7950f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5W",
      "roundness": null,
      "seed": 1597833079,
      "version": 290,
      "versionNonce": 1932127605,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772947606539,
      "link": null,
      "locked": false,
      "text": "【总结】也就是说：【原始的 X】截掉最后一个 token ，\n然后在最前面加上 <bos>，就是 dec_input。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "【总结】也就是说：【原始的 X】截掉最后一个 token ，\n然后在最前面加上 <bos>，就是 dec_input。",
      "autoResize": true,
      "lineHeight": 1.25
    },
